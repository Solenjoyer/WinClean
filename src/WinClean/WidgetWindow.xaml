<Window x:Class="WinClean.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WinClean.Controls"
        xmlns:r="clr-namespace:WinClean.Resources"
        xmlns:vm="clr-namespace:WinClean.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:WidgetViewModel}"
        Title="WinClean"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowActivated="False"
        Opacity="{Binding Opacity}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource NumericText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Height" Value="30" />
        </Style>
        <Style x:Key="Chart" TargetType="controls:Sparkline">
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Padding="14,10,14,12"
            Background="{DynamicResource WidgetBackgroundBrush}"
            BorderBrush="{DynamicResource WidgetStrokeBrush}" BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Grid Width="14" Height="14" VerticalAlignment="Center">
                    <Border CornerRadius="3" Background="#1F5FA8" />
                    <Path Data="M 4.17 9.83 A 4 4 0 1 1 9.83 9.83" Stroke="White" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Width="2" Height="2" Fill="White" />
                </Grid>
                <TextBlock Style="{StaticResource CaptionText}" Text="WinClean" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static r:Strings.Widget_Cpu}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CpuValue}" />
                    <controls:Sparkline Grid.Column="2" Style="{StaticResource Chart}" Source="{Binding History.Cpu}" Revision="{Binding HistoryVersion}"
                                        Stroke="{DynamicResource CpuSeriesBrush}" Fill="{DynamicResource CpuSeriesFillBrush}"
                                        AutomationProperties.Name="{x:Static r:Strings.Overview_CpuHistory}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static r:Strings.Widget_Memory}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding MemoryValue}" />
                    <controls:Sparkline Grid.Column="2" Style="{StaticResource Chart}" Source="{Binding History.Memory}" Revision="{Binding HistoryVersion}"
                                        Stroke="{DynamicResource MemorySeriesBrush}" Fill="{DynamicResource MemorySeriesFillBrush}"
                                        AutomationProperties.Name="{x:Static r:Strings.Overview_MemoryHistory}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static r:Strings.Widget_Disk}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DiskValue}" />
                    <controls:Sparkline Grid.Column="2" Style="{StaticResource Chart}" Source="{Binding History.DiskRead}" Revision="{Binding HistoryVersion}" AutoScale="True"
                                        Stroke="{DynamicResource DiskSeriesBrush}" Fill="{DynamicResource DiskSeriesFillBrush}"
                                        AutomationProperties.Name="{x:Static r:Strings.Overview_DiskHistory}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static r:Strings.Widget_Network}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding NetworkValue}" />
                    <controls:Sparkline Grid.Column="2" Style="{StaticResource Chart}" Source="{Binding History.NetworkReceive}" Revision="{Binding HistoryVersion}" AutoScale="True"
                                        Stroke="{DynamicResource NetworkSeriesBrush}" Fill="{DynamicResource NetworkSeriesFillBrush}"
                                        AutomationProperties.Name="{x:Static r:Strings.Overview_NetworkHistory}" />
                </Grid>
                <Grid Style="{StaticResource Row}" Visibility="{Binding GpuVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static r:Strings.Widget_Gpu}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding GpuValue}" />
                    <controls:Sparkline Grid.Column="2" Style="{StaticResource Chart}" Source="{Binding History.Gpu}" Revision="{Binding HistoryVersion}"
                                        Stroke="{DynamicResource GpuSeriesBrush}" Fill="{DynamicResource GpuSeriesFillBrush}"
                                        AutomationProperties.Name="{x:Static r:Strings.Overview_GpuHistory}" />
                </Grid>
                <Grid Style="{StaticResource Row}" Visibility="{Binding TemperatureVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static r:Strings.Widget_Temperature}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TemperatureValue}" />
                </Grid>
            </StackPanel>

            <TextBlock Style="{StaticResource NumericText}" Text="{Binding CompactText}" Margin="0,2,0,2"
                       Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Margin="0,8,0,0" Visibility="{Binding ToolsVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Static r:Strings.Widget_RunningNow}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WidgetToolRow}">
                            <Grid Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource NumericText}" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource NumericText}" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StorageText}" Margin="0,8,0,0"
                       Visibility="{Binding StorageVisible, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</Window>
