<UserControl x:Class="WinClean.Controls.InfoBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:WinClean.Resources"
             xmlns:vm="clr-namespace:WinClean.ViewModels"
             x:Name="Root">
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,8">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SubtleGlyphButton}"
                    Content="{x:Static vm:Glyphs.Cancel}"
                    ToolTip="{x:Static r:Strings.Common_Dismiss}"
                    AutomationProperties.Name="{x:Static r:Strings.Common_Dismiss}"
                    Command="{Binding DismissCommand, ElementName=Root}"
                    VerticalAlignment="Top"
                    Margin="12,-2,-6,0" />
            <TextBlock x:Name="Glyph"
                       DockPanel.Dock="Left"
                       Style="{StaticResource GlyphText}"
                       VerticalAlignment="Top"
                       Margin="0,2,10,0" />
            <TextBlock Style="{StaticResource BodyText}"
                       Text="{Binding Text, ElementName=Root}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</UserControl>
