<UserControl x:Class="WinClean.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="420"
                Margin="24">
        <TextBlock Style="{StaticResource BodyStrongText}"
                   Text="{Binding Title, ElementName=Root}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description, ElementName=Root}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ContentPresenter Content="{Binding Action, ElementName=Root}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
