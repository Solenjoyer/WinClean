<UserControl x:Class="WinClean.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="16,12,16,14">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="{Binding Title, ElementName=Root}" />
            <TextBlock Grid.Row="1"
                       Style="{StaticResource MetricValueText}"
                       Text="{Binding Value, ElementName=Root}"
                       Margin="0,2,0,0" />
            <TextBlock Grid.Row="2"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding Caption, ElementName=Root}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,0" />
            <ContentPresenter Grid.Row="3"
                              Content="{Binding Chart, ElementName=Root}"
                              Height="40"
                              Margin="0,12,0,0" />
        </Grid>
    </Border>
</UserControl>
