<UserControl x:Class="WinClean.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:WinClean.Resources"
             xmlns:vm="clr-namespace:WinClean.ViewModels"
             x:Name="Root">
    <Grid>
        <TextBox x:Name="Input"
                 Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                 Padding="30,0,28,0"
                 VerticalContentAlignment="Center"
                 MinHeight="32"
                 AutomationProperties.Name="{Binding Placeholder, ElementName=Root}" />
        <TextBlock Style="{StaticResource GlyphText}"
                   Text="{x:Static vm:Glyphs.Search}"
                   FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,0"
                   IsHitTestVisible="False" />
        <TextBlock Text="{Binding Placeholder, ElementName=Root}"
                   Style="{StaticResource SecondaryText}"
                   VerticalAlignment="Center"
                   Margin="31,0,0,0"
                   IsHitTestVisible="False">
            <TextBlock.Visibility>
                <Binding Path="Text" ElementName="Input" Converter="{StaticResource EmptyToVisible}" />
            </TextBlock.Visibility>
        </TextBlock>
        <Button x:Name="ClearButton"
                Style="{StaticResource SubtleGlyphButton}"
                Content="{x:Static vm:Glyphs.Clear}"
                ToolTip="{x:Static r:Strings.Common_Clear}"
                AutomationProperties.Name="{x:Static r:Strings.Common_Clear}"
                HorizontalAlignment="Right"
                Margin="0,0,4,0"
                Click="OnClear">
            <Button.Visibility>
                <Binding Path="Text" ElementName="Input" Converter="{StaticResource EmptyToVisible}" ConverterParameter="Invert" />
            </Button.Visibility>
        </Button>
    </Grid>
</UserControl>
