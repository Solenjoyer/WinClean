<UserControl x:Class="WinClean.Controls.NavRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:WinClean.Converters"
             xmlns:r="clr-namespace:WinClean.Resources"
             xmlns:vm="clr-namespace:WinClean.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel x:Name="Root" Width="200">
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                        <Setter Property="Width" Value="48" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>

        <Button DockPanel.Dock="Top"
                Style="{StaticResource NavRailToggle}"
                Command="{Binding ToggleCompactCommand}"
                AutomationProperties.Name="{x:Static r:Strings.Nav_Collapse}"
                ToolTip="{x:Static r:Strings.Nav_Collapse}">
            <TextBlock Style="{StaticResource GlyphText}" Text="{x:Static vm:Glyphs.GlobalNavigation}" />
        </Button>

        <ListBox Style="{StaticResource NavRailList}"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 AutomationProperties.Name="Navigation">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NavigationItem}">
                    <StackPanel Orientation="Horizontal"
                                ToolTip="{Binding Title}"
                                ToolTipService.IsEnabled="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock Style="{StaticResource GlyphText}"
                                   Text="{Binding Glyph}"
                                   Width="16" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="{Binding Title}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
