<dialogs:DialogWindow x:Class="WinClean.Dialogs.ErrorReportDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:dialogs="clr-namespace:WinClean.Dialogs"
                      xmlns:r="clr-namespace:WinClean.Resources"
                      xmlns:vm="clr-namespace:WinClean.ViewModels"
                      mc:Ignorable="d"
                      d:DataContext="{d:DesignInstance vm:ErrorReportViewModel}"
                      Title="{x:Static r:Strings.Error_Title}"
                      Width="580">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource BodyStrongText}"
                   Text="{x:Static r:Strings.Error_Heading}" />
        <TextBlock Style="{StaticResource BodyText}"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
        <TextBox x:Name="DetailsBox"
                 Text="{Binding Details, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12"
                 Height="180"
                 Margin="0,16,0,0" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{x:Static r:Strings.Error_CopyDetails}"
                    Click="OnCopyDetails"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static r:Strings.Error_OpenLogFolder}"
                    Command="{Binding OpenLogFolderCommand}"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static r:Strings.Error_Report}"
                    Command="{Binding ReportCommand}"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static r:Strings.Common_Close}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="80" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
