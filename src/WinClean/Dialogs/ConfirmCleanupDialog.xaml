<dialogs:DialogWindow x:Class="WinClean.Dialogs.ConfirmCleanupDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:dialogs="clr-namespace:WinClean.Dialogs"
                      xmlns:r="clr-namespace:WinClean.Resources"
                      xmlns:vm="clr-namespace:WinClean.ViewModels"
                      mc:Ignorable="d"
                      d:DataContext="{d:DesignInstance dialogs:CleanupPrompt}"
                      Title="{x:Static r:Strings.Nav_Cleanup}"
                      Width="500">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding Question}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,12,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}" Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Notices}" Margin="0,8,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,4">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource GlyphText}"
                                   Text="{x:Static vm:Glyphs.StatusInfo}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,2,10,0" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" TextWrapping="Wrap" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{Binding ConfirmLabel}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Click="OnConfirm"
                    MinWidth="140"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static r:Strings.Common_Cancel}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="90" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
