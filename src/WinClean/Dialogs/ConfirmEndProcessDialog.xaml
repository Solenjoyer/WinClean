<dialogs:DialogWindow x:Class="WinClean.Dialogs.ConfirmEndProcessDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:dialogs="clr-namespace:WinClean.Dialogs"
                      xmlns:r="clr-namespace:WinClean.Resources"
                      xmlns:vm="clr-namespace:WinClean.ViewModels"
                      mc:Ignorable="d"
                      d:DataContext="{d:DesignInstance dialogs:EndProcessPrompt}"
                      Title="{x:Static r:Strings.Processes_EndProcess}"
                      Width="460">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource SubtitleText}"
                   Text="{Binding Question}"
                   TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource BodyText}"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
        <DockPanel Margin="0,12,0,0"
                   Visibility="{Binding RequiresAcknowledgement, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Left"
                       Style="{StaticResource GlyphText}"
                       Text="{x:Static vm:Glyphs.Warning}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       VerticalAlignment="Top"
                       Margin="0,2,10,0" />
            <TextBlock Style="{StaticResource BodyText}"
                       Text="{Binding Warning}"
                       TextWrapping="Wrap" />
        </DockPanel>
        <CheckBox x:Name="Acknowledge"
                  Content="{x:Static r:Strings.Processes_Acknowledge}"
                  Margin="0,12,0,0"
                  Checked="OnAcknowledgeChanged"
                  Unchecked="OnAcknowledgeChanged"
                  Visibility="{Binding RequiresAcknowledgement, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button x:Name="ConfirmButton"
                    Content="{Binding ConfirmLabel}"
                    Click="OnConfirm"
                    MinWidth="110"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static r:Strings.Common_Cancel}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="90" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
