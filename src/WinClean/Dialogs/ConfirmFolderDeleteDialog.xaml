<dialogs:DialogWindow x:Class="WinClean.Dialogs.ConfirmFolderDeleteDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:dialogs="clr-namespace:WinClean.Dialogs"
                      xmlns:r="clr-namespace:WinClean.Resources"
                      Title="{x:Static r:Strings.Nav_Cleanup}"
                      Width="500">
    <StackPanel Margin="24">
        <TextBlock x:Name="Question" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBox x:Name="Input" Margin="0,12,0,0" TextChanged="OnTextChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="ConfirmButton"
                    Content="{x:Static r:Strings.Cleanup_FolderConfirmDelete}"
                    Click="OnConfirm"
                    IsEnabled="False"
                    MinWidth="120"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static r:Strings.Common_Cancel}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="90" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
