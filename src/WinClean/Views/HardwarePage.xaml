<UserControl x:Class="WinClean.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:r="clr-namespace:WinClean.Resources"
             xmlns:vm="clr-namespace:WinClean.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HardwareViewModel}"
             Loaded="OnLoaded">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <DockPanel Margin="24,0,24,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{x:Static r:Strings.Hardware_CopySummary}" Command="{Binding CopySummaryCommand}" Margin="12,0,0,0" />
            <CheckBox Content="{x:Static r:Strings.Hardware_ShowIdentifiers}" IsChecked="{Binding ShowIdentifiers}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryText}" Text="{x:Static r:Strings.Hardware_Reading}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HardwareCard}">
                        <Border Style="{StaticResource Card}" Width="420" Margin="6,0,6,12" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyStrongText}" Text="{Binding Title}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Facts}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FactItem}">
                                            <Grid Margin="0,3" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Value, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         MinHeight="0"
                                                         FontSize="14"
                                                         TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
