<UserControl x:Class="WinClean.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WinClean.Controls"
             xmlns:r="clr-namespace:WinClean.Resources"
             xmlns:vm="clr-namespace:WinClean.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style x:Key="Choice" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="170" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Appearance}" />
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_Theme}">
                        <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding ThemeIndex}">
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_ThemeSystem}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_ThemeLight}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_ThemeDark}" />
                        </ComboBox>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Monitoring}" />
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_RefreshInterval}" Description="{x:Static r:Strings.Settings_RefreshIntervalDescription}">
                        <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding RefreshIntervalIndex}">
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Seconds1}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Seconds2}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Seconds5}" />
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_ShowSystemProcesses}" Description="{x:Static r:Strings.Settings_ShowSystemProcessesDescription}">
                        <CheckBox IsChecked="{Binding ShowSystemProcesses}" AutomationProperties.Name="{x:Static r:Strings.Settings_ShowSystemProcesses}" />
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_GroupByApplication}" Description="{x:Static r:Strings.Settings_GroupByApplicationDescription}">
                        <CheckBox IsChecked="{Binding GroupByApplication}" AutomationProperties.Name="{x:Static r:Strings.Settings_GroupByApplication}" />
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_TemperatureUnit}">
                        <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding TemperatureUnitIndex}">
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Celsius}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Fahrenheit}" />
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_Sensors}" Description="{x:Static r:Strings.Settings_SensorsDescription}">
                        <CheckBox IsChecked="{Binding SensorsEnabled}" AutomationProperties.Name="{x:Static r:Strings.Settings_Sensors}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Tray}" />
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_TrayEnabled}" Description="{x:Static r:Strings.Settings_TrayEnabledDescription}">
                        <CheckBox IsChecked="{Binding TrayEnabled}" AutomationProperties.Name="{x:Static r:Strings.Settings_TrayEnabled}" />
                    </controls:SettingRow>
                    <StackPanel IsEnabled="{Binding TrayEnabled}">
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_TrayStyle}">
                            <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding TrayStyleIndex}">
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_TrayStyleBars}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_TrayStyleNumber}" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_TrayMetrics}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{x:Static r:Strings.Settings_TrayCpu}" IsChecked="{Binding TrayShowCpu}" />
                                <CheckBox Content="{x:Static r:Strings.Settings_TrayMemory}" IsChecked="{Binding TrayShowMemory}" Margin="16,0,0,0" />
                                <CheckBox Content="{x:Static r:Strings.Settings_TrayDisk}" IsChecked="{Binding TrayShowDisk}" Margin="16,0,0,0" />
                            </StackPanel>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_CloseToTray}" Description="{x:Static r:Strings.Settings_CloseToTrayDescription}">
                            <CheckBox IsChecked="{Binding CloseToTray}" AutomationProperties.Name="{x:Static r:Strings.Settings_CloseToTray}" />
                        </controls:SettingRow>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Widget}" />
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetEnabled}" Description="{x:Static r:Strings.Settings_WidgetEnabledDescription}">
                        <CheckBox IsChecked="{Binding WidgetEnabled}" AutomationProperties.Name="{x:Static r:Strings.Settings_WidgetEnabled}" />
                    </controls:SettingRow>
                    <StackPanel IsEnabled="{Binding WidgetEnabled}">
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetPlacement}" Description="{x:Static r:Strings.Settings_WidgetPlacementDescription}">
                            <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding WidgetPlacementIndex}">
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_WidgetAlwaysOnTop}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_WidgetBehindWindows}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_WidgetNormal}" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetLayout}">
                            <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding WidgetLayoutIndex}">
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_WidgetLayoutFull}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_WidgetLayoutCompact}" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetOpacity}">
                            <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding WidgetOpacityIndex}">
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_Percent60}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_Percent75}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_Percent90}" />
                                <ComboBoxItem Content="{x:Static r:Strings.Settings_Percent100}" />
                            </ComboBox>
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetShowsTools}" Description="{x:Static r:Strings.Settings_WidgetShowsToolsDescription}">
                            <CheckBox IsChecked="{Binding WidgetShowsTools}" AutomationProperties.Name="{x:Static r:Strings.Settings_WidgetShowsTools}" />
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetShowsStorage}">
                            <CheckBox IsChecked="{Binding WidgetShowsStorage}" AutomationProperties.Name="{x:Static r:Strings.Settings_WidgetShowsStorage}" />
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetLocked}" Description="{x:Static r:Strings.Settings_WidgetLockedDescription}">
                            <CheckBox IsChecked="{Binding WidgetLocked}" AutomationProperties.Name="{x:Static r:Strings.Settings_WidgetLocked}" />
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetClickThrough}" Description="{x:Static r:Strings.Settings_WidgetClickThroughDescription}">
                            <CheckBox IsChecked="{Binding WidgetClickThrough}" AutomationProperties.Name="{x:Static r:Strings.Settings_WidgetClickThrough}" />
                        </controls:SettingRow>
                        <controls:SettingRow Title="{x:Static r:Strings.Settings_WidgetResetPosition}" Description="{x:Static r:Strings.Settings_WidgetResetPositionDescription}">
                            <Button Content="{x:Static r:Strings.Settings_WidgetResetPosition}" Command="{Binding ResetWidgetPositionCommand}" />
                        </controls:SettingRow>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Startup}" />
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_StartWithWindows}" Description="{x:Static r:Strings.Settings_StartWithWindowsDescription}">
                        <CheckBox IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="{x:Static r:Strings.Settings_StartWithWindows}" />
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_StartMinimized}" Description="{x:Static r:Strings.Settings_StartMinimizedDescription}" IsEnabled="{Binding StartWithWindows}">
                        <CheckBox IsChecked="{Binding StartMinimized}" AutomationProperties.Name="{x:Static r:Strings.Settings_StartMinimized}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Cleanup}" />
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_CleanupConfirmation}" Description="{x:Static r:Strings.Settings_CleanupConfirmationDescription}">
                        <CheckBox IsChecked="True" IsEnabled="False" AutomationProperties.Name="{x:Static r:Strings.Settings_CleanupConfirmation}" />
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_TemporaryAge}" Description="{x:Static r:Strings.Settings_TemporaryAgeDescription}">
                        <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding TemporaryAgeIndex}">
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Hours1}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Hours6}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Hours24}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Hours48}" />
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_StaleDays}" Description="{x:Static r:Strings.Settings_StaleDaysDescription}">
                        <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding StaleDaysIndex}">
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days30}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days60}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days90}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days180}" />
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_OldDownloadDays}">
                        <ComboBox Style="{StaticResource Choice}" SelectedIndex="{Binding OldDownloadDaysIndex}">
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days30}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days90}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days180}" />
                            <ComboBoxItem Content="{x:Static r:Strings.Settings_Days365}" />
                        </ComboBox>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Administrator}" />
                    <controls:SettingRow Title="{Binding ElevationText}">
                        <Button Content="{x:Static r:Strings.Settings_RestartAsAdministrator}"
                                Command="{Binding RestartAsAdministratorCommand}"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Logging}" />
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_VerboseLogging}" Description="{x:Static r:Strings.Settings_VerboseLoggingDescription}">
                        <CheckBox IsChecked="{Binding VerboseLogging}" AutomationProperties.Name="{x:Static r:Strings.Settings_VerboseLogging}" />
                    </controls:SettingRow>
                    <controls:SettingRow Title="{x:Static r:Strings.Settings_DataFolder}" Description="{Binding DataFolderDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static r:Strings.Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="{x:Static r:Strings.Settings_OpenLogFolder}" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </controls:SettingRow>
                    <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_Diagnostics}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{x:Static r:Strings.Settings_DiagnosticsDescription}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Diagnostics}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DiagnosticItem}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="{Binding Status}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static r:Strings.Settings_About}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding VersionText}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{x:Static r:Strings.Settings_License}" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{x:Static r:Strings.Settings_Privacy}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding WorkingSetText}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                        <Button Content="{x:Static r:Strings.Settings_OpenReleases}" Command="{Binding OpenReleasesCommand}" />
                        <Button Content="{x:Static r:Strings.Settings_OpenRepository}" Command="{Binding OpenRepositoryCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
