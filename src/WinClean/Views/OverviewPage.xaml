<UserControl x:Class="WinClean.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WinClean.Controls"
             xmlns:converters="clr-namespace:WinClean.Converters"
             xmlns:r="clr-namespace:WinClean.Resources"
             xmlns:vm="clr-namespace:WinClean.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OverviewViewModel}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
        <StackPanel>
            <UniformGrid Rows="1" Margin="-6,0">
                <controls:MetricCard Title="{x:Static r:Strings.Overview_Cpu}" Value="{Binding CpuValue}" Caption="{Binding CpuCaption}" Margin="6,0">
                    <controls:MetricCard.Chart>
                        <controls:Sparkline Source="{Binding History.Cpu}" Revision="{Binding HistoryVersion}"
                                            Stroke="{DynamicResource CpuSeriesBrush}" Fill="{DynamicResource CpuSeriesFillBrush}"
                                            AutomationProperties.Name="{x:Static r:Strings.Overview_CpuHistory}" />
                    </controls:MetricCard.Chart>
                </controls:MetricCard>
                <controls:MetricCard Title="{x:Static r:Strings.Overview_Memory}" Value="{Binding MemoryValue}" Caption="{Binding MemoryCaption}" Margin="6,0">
                    <controls:MetricCard.Chart>
                        <controls:Sparkline Source="{Binding History.Memory}" Revision="{Binding HistoryVersion}"
                                            Stroke="{DynamicResource MemorySeriesBrush}" Fill="{DynamicResource MemorySeriesFillBrush}"
                                            AutomationProperties.Name="{x:Static r:Strings.Overview_MemoryHistory}" />
                    </controls:MetricCard.Chart>
                </controls:MetricCard>
                <controls:MetricCard Title="{x:Static r:Strings.Overview_Disk}" Value="{Binding DiskValue}" Caption="{Binding DiskCaption}" Margin="6,0">
                    <controls:MetricCard.Chart>
                        <controls:Sparkline Source="{Binding History.DiskRead}" Revision="{Binding HistoryVersion}" AutoScale="True"
                                            Stroke="{DynamicResource DiskSeriesBrush}" Fill="{DynamicResource DiskSeriesFillBrush}"
                                            AutomationProperties.Name="{x:Static r:Strings.Overview_DiskHistory}" />
                    </controls:MetricCard.Chart>
                </controls:MetricCard>
                <controls:MetricCard Title="{x:Static r:Strings.Overview_Network}" Value="{Binding NetworkValue}" Caption="{Binding NetworkCaption}" Margin="6,0">
                    <controls:MetricCard.Chart>
                        <controls:Sparkline Source="{Binding History.NetworkReceive}" Revision="{Binding HistoryVersion}" AutoScale="True"
                                            Stroke="{DynamicResource NetworkSeriesBrush}" Fill="{DynamicResource NetworkSeriesFillBrush}"
                                            AutomationProperties.Name="{x:Static r:Strings.Overview_NetworkHistory}" />
                    </controls:MetricCard.Chart>
                </controls:MetricCard>
                <controls:MetricCard Title="{x:Static r:Strings.Overview_Gpu}" Value="{Binding GpuValue}" Caption="{Binding GpuCaption}" Margin="6,0"
                                     Visibility="{Binding GpuVisible, Converter={StaticResource BoolToVisibility}}">
                    <controls:MetricCard.Chart>
                        <controls:Sparkline Source="{Binding History.Gpu}" Revision="{Binding HistoryVersion}"
                                            Stroke="{DynamicResource GpuSeriesBrush}" Fill="{DynamicResource GpuSeriesFillBrush}"
                                            AutomationProperties.Name="{x:Static r:Strings.Overview_GpuHistory}" />
                    </controls:MetricCard.Chart>
                </controls:MetricCard>
            </UniformGrid>

            <Grid ColumnDefinitions="2*,12,*" Margin="0,12,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongText}" Text="{x:Static r:Strings.Overview_Storage}" />
                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VolumeItem}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,6">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="{Binding FreeText}" Margin="12,0,0,0" />
                                        <controls:ProportionBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding UsedPercent}" IsCritical="{Binding IsCritical}" Margin="0,6,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongText}" Text="{x:Static r:Strings.Overview_System}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}" x:Key="FactLabel">
                                    <Setter Property="Margin" Value="0,4,16,4" />
                                </Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}" x:Key="FactValue">
                                    <Setter Property="Margin" Value="0,4" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Style="{StaticResource FactLabel}" Text="{x:Static r:Strings.Overview_Uptime}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding UptimeText}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FactLabel}" Text="{x:Static r:Strings.Overview_Processes}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding ProcessesText}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FactLabel}" Text="{x:Static r:Strings.Overview_Commit}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding CommitText}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FactLabel}" Text="{x:Static r:Strings.Overview_Battery}"
                                       Visibility="{Binding BatteryVisible, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding BatteryText}"
                                       Visibility="{Binding BatteryVisible, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
