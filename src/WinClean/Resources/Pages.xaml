<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WinClean.Views"
                    xmlns:vm="clr-namespace:WinClean.ViewModels">

    <!-- Each page view model is rendered by its page control. -->
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
        <views:OverviewPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
        <views:ProcessesPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StorageViewModel}">
        <views:StoragePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
        <views:CleanupPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HealthViewModel}">
        <views:HealthPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
        <views:HardwarePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsPage />
    </DataTemplate>

</ResourceDictionary>
