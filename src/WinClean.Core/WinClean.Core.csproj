<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinClean.Core</RootNamespace>
    <Description>Platform-neutral models, rules and parsers behind WinClean.</Description>
    <!--
      Restore-only: publishing the app with -r passes the runtime identifier down to this project, and a
      locked restore then has to find the same identifiers in this lock file as a plain restore does.
    -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinClean.Core.Tests" />
  </ItemGroup>

</Project>
